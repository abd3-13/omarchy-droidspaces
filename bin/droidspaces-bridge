#!/usr/bin/python3
# Droidspaces <-> Omarchy shell bridge.
#
# Runs as root (started through pkexec by bin/ensure-helper) and speaks a
# line oriented JSON protocol on stdin/stdout:
#
#   in : {"cmd":"refresh"}
#        {"cmd":"watch","open":true|false}
#        {"cmd":"start"|"stop"|"restart","name":"...","req":"..."}
#        {"cmd":"logs","name":"...","lines":120,"req":"..."}
#        {"cmd":"check","req":"..."}
#        {"cmd":"create","name":"...","tarball":"...","image":"...",
#         "size":"16G","hostname":"...","start":false,"options":{...},
#         "req":"..."}
#        {"cmd":"exit"}
#
#   out: {"type":"hello",...}
#        {"type":"state",...}                 (periodic + after every action)
#        {"type":"progress","req":...,...}    (create stages)
#        {"type":"result","req":...,...}
#        {"type":"fatal","message":...}
#
# The process exits when stdin closes, so it cannot outlive the shell that
# started it. It never invokes a shell and only accepts a fixed set of
# commands for container names matching NAME_RE.
#
# SPDX-License-Identifier: MIT

import argparse
import json
import math
import os
import pwd
import queue
import re
import shutil
import signal
import stat
import subprocess
import sys
import threading
import time

DEFAULT_WORKSPACE = "/var/lib/Droidspaces"
DROIDSPACES = "/usr/bin/droidspaces"
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")
MAX_LINE = 1 << 20
IDLE_INTERVAL = 6.0
OPEN_INTERVAL = 2.0
MAX_OUTPUT = 6000

ACTIONS = ("start", "stop", "restart")
COMMANDS = set(ACTIONS) | {"refresh", "watch", "logs", "check", "create", "exit"}
SIZE_RE = re.compile(r"^([0-9]+(?:\.[0-9]+)?)\s*([KMGT]?)B?$", re.IGNORECASE)
SIZE_UNITS = {"": 1, "K": 1 << 10, "M": 1 << 20, "G": 1 << 30, "T": 1 << 40}
MIN_IMAGE_SIZE = 256 << 20
CREATE_TIMEOUT = 60 * 60
NET_MODES = ("nat", "gateway", "macvlan", "host", "none")
MACVLAN_MODES = ("bridge", "private", "vepa", "passthru")
PRIVILEGED_TAGS = ("nomask", "nocaps", "noseccomp", "shared", "full")


def log(message):
    try:
        sys.stderr.write("droidspaces-bridge: %s\n" % message)
        sys.stderr.flush()
    except Exception:
        pass


def clean(text, limit=MAX_OUTPUT):
    text = ANSI_RE.sub("", text or "")
    text = text.replace("\r\n", "\n").replace("\r", "\n").strip()
    if len(text) > limit:
        text = text[-limit:]
    return text


def parse_size(text):
    match = SIZE_RE.match(str(text or "").strip())
    if not match:
        return None
    try:
        value = float(match.group(1))
    except ValueError:
        return None
    if value <= 0:
        return None
    return int(value * SIZE_UNITS[match.group(2).upper()])


def as_bool(value):
    if isinstance(value, bool):
        return value
    return str(value or "").strip().lower() in ("1", "true", "yes", "on")


def find_tool(*names):
    for name in names:
        if os.path.isabs(name):
            if os.access(name, os.X_OK):
                return name
            continue
        found = shutil.which(name)
        if found:
            return found
    return None


def run_process(args, timeout):
    try:
        completed = subprocess.run(
            args,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            close_fds=True,
        )
        return (
            completed.returncode,
            completed.stdout.decode("utf-8", "replace"),
            completed.stderr.decode("utf-8", "replace"),
        )
    except subprocess.TimeoutExpired:
        return 124, "", "timed out after %ss" % timeout
    except OSError as exc:
        return 127, "", str(exc)


def command_error(code, out, err):
    text = clean(err or out, 800)
    if text:
        return text.splitlines()[-1]
    return "command exited with code %d" % code


def user_path(value):
    value = str(value or "").strip()
    if value == "~" or value.startswith("~/"):
        home = ""
        uid = os.environ.get("PKEXEC_UID", "")
        if uid.isdigit():
            try:
                home = pwd.getpwuid(int(uid)).pw_dir
            except KeyError:
                home = ""
        if not home:
            home = os.path.expanduser("~")
        value = home + value[1:]
    if not value:
        return ""
    return os.path.abspath(value)


def write_config(path, text):
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
    try:
        os.write(fd, text.encode("utf-8"))
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(tmp, path)


def build_container_config(item, name, hostname, image):
    """Validate the create form's CLI options and render a config file."""
    opts = item.get("options")
    if not isinstance(opts, dict):
        opts = {}

    def text(key):
        value = opts.get(key, "")
        if isinstance(value, bool):
            return "1" if value else ""
        return str(value or "").strip()

    string_labels = {
        "init": "Init binary",
        "env_file": "Environment file",
        "bind_mounts": "Bind mounts",
        "nat_ip": "Static NAT IP",
        "upstream": "Upstream interfaces",
        "ports": "Port forwards",
        "dns": "DNS servers",
        "gateway": "Gateway container",
        "gateway_net": "Gateway network",
        "gateway_iface": "Gateway interface",
        "gateway_bridge": "Gateway bridge",
        "macvlan_parent": "MACVLAN parent",
        "privileged": "Privileged tags",
    }
    for key, label in string_labels.items():
        value = text(key)
        if "\n" in value or "\r" in value:
            return None, "%s cannot contain newlines." % label

    net_mode = text("net_mode") or "nat"
    if net_mode not in NET_MODES:
        return None, "Invalid network mode: " + net_mode

    init = text("init")
    if " " in init:
        return None, "Init binary cannot contain spaces."

    env_file = text("env_file")
    if env_file and not os.path.isabs(env_file):
        return None, "Environment file path must be absolute."
    if env_file and not os.path.isfile(env_file):
        return None, "Environment file not found: " + env_file

    bind_mounts = text("bind_mounts")
    if bind_mounts:
        for entry in bind_mounts.split(","):
            parts = entry.strip().split(":")
            if len(parts) < 2 or not parts[0] or not parts[1]:
                return None, "Bind mounts must look like SRC:DEST[:ro]."
            if not parts[0].startswith("/") or not parts[1].startswith("/"):
                return None, "Bind mount paths must be absolute."
            if len(parts) > 2 and parts[2] != "ro":
                return None, "Bind mount options must be 'ro' or empty."

    memory = 0
    raw_memory = text("memory")
    if raw_memory:
        memory = parse_size(raw_memory)
        if memory is None or memory < 4 * 1024 * 1024:
            return None, "Memory must be a size like 512M or 2G (minimum 4M)."

    cpu_quota = 0
    raw_cpus = text("cpus")
    if raw_cpus:
        try:
            cpus = float(raw_cpus)
        except ValueError:
            return None, "CPUs must be a number like 1 or 1.5."
        if not math.isfinite(cpus) or cpus < 0.01:
            return None, "CPUs must be at least 0.01."
        cpu_quota = int(cpus * 100000)
        if cpu_quota < 1000:
            return None, "CPUs value is too small."

    pids = 0
    raw_pids = text("pids_limit")
    if raw_pids:
        pids = as_int(raw_pids, -1)
        if pids < 16 or pids > 4194304:
            return None, "PID limit must be between 16 and 4194304."

    privileged = text("privileged")
    if privileged:
        tags = [tag.strip() for tag in privileged.split(",") if tag.strip()]
        if not tags or any(tag not in PRIVILEGED_TAGS for tag in tags):
            return None, "Privileged tags must be: " + ", ".join(PRIVILEGED_TAGS) + "."
        privileged = ",".join(tags)

    macvlan_mode = text("macvlan_mode") or "bridge"
    if macvlan_mode not in MACVLAN_MODES:
        return None, "Invalid MACVLAN mode: " + macvlan_mode

    nat_ip = text("nat_ip")
    upstream = text("upstream")
    ports = text("ports")
    dns = text("dns")
    gateway = text("gateway")
    gateway_net = text("gateway_net")
    gateway_iface = text("gateway_iface")
    gateway_bridge = text("gateway_bridge")
    macvlan_parent = text("macvlan_parent")

    if net_mode == "gateway" and not gateway:
        return None, "Gateway mode needs a gateway container."
    if net_mode == "macvlan" and not macvlan_parent:
        return None, "MACVLAN mode needs a parent interface."

    lines = [
        "# Droidspaces Container Configuration",
        "# Generated by the Omarchy Droidspaces plugin",
        "",
        "name=" + name,
        "hostname=" + hostname,
        "rootfs_path=" + image,
        "net_mode=" + net_mode,
    ]
    if init:
        lines.append("custom_init=" + init)
    if env_file:
        lines.append("env_file=" + env_file)
    if bind_mounts:
        lines.append("bind_mounts=" + bind_mounts)
    if net_mode == "nat":
        if nat_ip:
            lines.append("static_nat_ip=" + nat_ip)
        if upstream:
            lines.append("upstream_interfaces=" + upstream)
        if ports:
            lines.append("port_forwards=" + ports)
    elif net_mode == "gateway":
        lines.append("gateway_container=" + gateway)
        if gateway_net:
            lines.append("gateway_net=" + gateway_net)
        if gateway_iface:
            lines.append("gateway_lan_ifname=" + gateway_iface)
        if gateway_bridge:
            lines.append("gateway_bridge=" + gateway_bridge)
    elif net_mode == "macvlan":
        lines.append("macvlan_parent=" + macvlan_parent)
        if macvlan_mode != "bridge":
            lines.append("macvlan_mode=" + macvlan_mode)
    if dns:
        lines.append("dns_servers=" + dns)
    for key, config_key in (
        ("disable_ipv6", "disable_ipv6"),
        ("hw_access", "enable_hw_access"),
        ("allow_vts", "allow_vts"),
        ("gpu", "enable_gpu_mode"),
        ("x11", "enable_x11"),
        ("allow_swap", "allow_swap"),
        ("selinux_permissive", "selinux_permissive"),
        ("allow_sandboxing", "allow_sandboxing"),
        ("volatile", "volatile_mode"),
        ("force_cgroupv1", "force_cgroupv1"),
    ):
        if as_bool(opts.get(key)):
            lines.append(config_key + "=1")
    if memory:
        lines.append("memory_limit=%d" % memory)
    if cpu_quota:
        lines.append("cpu_period=100000")
        lines.append("cpu_quota=%d" % cpu_quota)
    if pids:
        lines.append("pids_limit=%d" % pids)
    if privileged:
        lines.append("privileged=" + privileged)
    return "\n".join(lines) + "\n", None


def proc_cmdline(pid):
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as handle:
            raw = handle.read()
    except OSError:
        return []
    return [part.decode("utf-8", "replace") for part in raw.split(b"\0") if part]


def proc_uid(pid):
    try:
        with open("/proc/%d/status" % pid, "r", encoding="ascii", errors="ignore") as handle:
            for line in handle:
                if line.startswith("Uid:"):
                    return int(line.split()[1])
    except (OSError, ValueError):
        return -1
    return -1


def replace_instances(program):
    """Terminate older copies of this same installed bridge.

    Quickshell does not reap a plugin's child processes when the plugin is
    reloaded, so a reload with an open panel used to leave root helpers
    behind. A single session only needs one bridge, so the freshly launched
    helper stops the old ones before taking over.
    """
    me = os.getpid()
    target = os.path.realpath(program)
    victims = []
    try:
        entries = os.listdir("/proc")
    except OSError:
        return
    for entry in entries:
        if not entry.isdigit():
            continue
        pid = int(entry)
        if pid == me:
            continue
        if proc_uid(pid) != 0:
            continue
        args = proc_cmdline(pid)
        if not args:
            continue
        first = os.path.realpath(args[0])
        ours = first == target
        if not ours and len(args) > 1 and os.path.basename(first).startswith("python"):
            ours = os.path.realpath(args[1]) == target
        if ours:
            victims.append(pid)
    for pid in victims:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    deadline = time.monotonic() + 2.0
    while victims and time.monotonic() < deadline:
        victims = [pid for pid in victims if os.path.exists("/proc/%d" % pid)]
        if victims:
            time.sleep(0.05)
    for pid in victims:
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass


def summarize_check(text):
    """Turn `droidspaces --json check` into a short readable summary.

    Returns (message, passed) or None when the output is not the expected
    JSON object.
    """
    try:
        data = json.loads(text)
    except ValueError:
        return None
    if not isinstance(data, dict):
        return None
    ok = 0
    missing = []
    for key, value in data.items():
        if key in ("version", "requirements_met"):
            continue
        if value in (0, False, "0"):
            missing.append(key)
        elif value in (1, True, "1"):
            ok += 1
    met = data.get("requirements_met")
    passed = bool(met) if met is not None else not missing
    lines = ["%s (%d/%d checks)" % (
        "System check passed" if passed else "System check found problems",
        ok,
        ok + len(missing),
    )]
    if missing:
        lines.append("Missing: " + ", ".join(missing))
    return "\n".join(lines), passed


def as_int(value, default=0):
    try:
        return int(str(value).strip(), 10)
    except (TypeError, ValueError):
        return default


def read_config(path):
    values = {}
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as handle:
            for raw in handle:
                line = raw.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                values[key.strip()] = value.strip()
    except OSError:
        return None
    return values


def rootfs_kind(path):
    if not path:
        return "unknown"
    try:
        info = os.stat(path)
    except OSError:
        return "missing"
    if stat.S_ISBLK(info.st_mode):
        return "block"
    if stat.S_ISDIR(info.st_mode):
        return "directory"
    if stat.S_ISREG(info.st_mode):
        return "image"
    return "other"


def log_info(workspace, name):
    if not NAME_RE.match(name):
        return "", 0
    base = os.path.realpath(os.path.join(workspace, "Logs"))
    path = os.path.realpath(os.path.join(base, name, "log"))
    if not path.startswith(base + os.sep):
        return "", 0
    try:
        size = os.path.getsize(path)
    except OSError:
        return "", 0
    return path, size


class Bridge:
    def __init__(self, workspace, allow_nonroot=False, once=False):
        self.workspace = workspace
        self.allow_nonroot = allow_nonroot
        self.once = once
        self.out_lock = threading.Lock()
        self.ds_lock = threading.Lock()
        self.actions = queue.Queue()
        self.dirty = threading.Event()
        self.stop = threading.Event()
        self.open = False
        self.interval = IDLE_INTERVAL
        self.commands = queue.Queue()
        self.version = ""
        self.mode = ""
        self.last_show_error = ""

    # -- output ---------------------------------------------------------
    def emit(self, payload):
        line = json.dumps(payload, separators=(",", ":"), ensure_ascii=False)
        with self.out_lock:
            try:
                sys.stdout.write(line + "\n")
                sys.stdout.flush()
            except (BrokenPipeError, ValueError):
                self.stop.set()

    # -- droidspaces ----------------------------------------------------
    def run(self, args, timeout):
        # droidspaces reads and prunes the same pid/config/workspace state, so
        # never let the status poll overlap a start/stop/restart.
        with self.ds_lock:
            try:
                completed = subprocess.run(
                    args,
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    timeout=timeout,
                    close_fds=True,
                )
                out = completed.stdout.decode("utf-8", "replace")
                err = completed.stderr.decode("utf-8", "replace")
                return completed.returncode, out, err
            except subprocess.TimeoutExpired:
                return 124, "", "timed out after %ss" % timeout
            except OSError as exc:
                return 127, "", str(exc)

    def probe(self):
        if not os.access(DROIDSPACES, os.X_OK):
            return
        code, out, _ = self.run([DROIDSPACES, "version"], 5)
        if code == 0:
            self.version = clean(out, 64).splitlines()[-1] if out.strip() else ""
        code, out, _ = self.run([DROIDSPACES, "mode"], 5)
        if code == 0:
            self.mode = clean(out, 64).splitlines()[-1] if out.strip() else ""

    def show(self):
        if os.geteuid() != 0 and not self.allow_nonroot:
            return None
        code, out, err = self.run([DROIDSPACES, "--json", "show"], 20)
        if code != 0:
            self.last_show_error = clean(err or out, 400) or (
                "droidspaces exited with code %d" % code
            )
            return None
        self.last_show_error = ""
        start = out.find("{")
        end = out.rfind("}")
        if start < 0 or end <= start:
            return None
        try:
            data = json.loads(out[start:end + 1])
        except ValueError:
            return None
        return data if isinstance(data, dict) else None

    # -- state ----------------------------------------------------------
    def collect(self):
        show = self.show()
        running = {}
        if show:
            for entry in show.get("running") or []:
                if isinstance(entry, dict) and NAME_RE.match(str(entry.get("name", ""))):
                    running[str(entry["name"])] = entry

        containers = []
        seen = set()
        cdir = os.path.join(self.workspace, "Containers")
        try:
            entries = sorted(os.listdir(cdir))
        except OSError:
            entries = []
        for entry in entries:
            folder = os.path.join(cdir, entry)
            if not os.path.isdir(folder):
                continue
            cfg = read_config(os.path.join(folder, "container.config"))
            if cfg is None:
                continue
            name = cfg.get("name") or entry
            if not NAME_RE.match(name):
                name = entry if NAME_RE.match(entry) else ""
            if not name:
                continue
            seen.add(name)
            live = running.get(name) or running.get(entry) or {}
            containers.append(self.describe(name, cfg, live))

        # A running container whose config folder vanished (moved rootfs,
        # upgraded workspace) is still worth listing.
        for name, live in running.items():
            if name not in seen:
                containers.append(self.describe(name, {}, live))

        containers.sort(key=lambda c: (not c["running"], c["name"].lower()))

        mem_total = 0
        mem_used = 0
        try:
            with open("/proc/meminfo", "r", encoding="ascii", errors="ignore") as handle:
                for line in handle:
                    if line.startswith("MemTotal:"):
                        mem_total = as_int(line.split()[1])
                    elif line.startswith("MemAvailable:"):
                        mem_used = max(0, mem_total - as_int(line.split()[1]))
        except OSError:
            pass
        try:
            load1 = os.getloadavg()[0]
        except OSError:
            load1 = 0.0

        return {
            "type": "state",
            "ts": int(time.time()),
            "version": self.version,
            "mode": self.mode,
            "workspace": self.workspace,
            "available": os.access(DROIDSPACES, os.X_OK),
            "error": self.last_show_error,
            "total": len(containers),
            "running_count": sum(1 for c in containers if c["running"]),
            "ram_used_kb": sum(c["ram_used_kb"] for c in containers),
            "host": {
                "cpus": os.cpu_count() or 0,
                "load1": round(load1, 2),
                "mem_total_kb": mem_total,
                "mem_used_kb": mem_used,
            },
            "containers": containers,
        }

    def describe(self, name, cfg, live):
        running = bool(live)
        rootfs = cfg.get("rootfs_path", "")
        kind = rootfs_kind(rootfs)
        quota = as_int(cfg.get("cpu_quota"))
        period = as_int(cfg.get("cpu_period")) or 100000
        mem_limit = as_int(cfg.get("memory_limit"))
        log_path, log_size = log_info(self.workspace, name)
        ports = cfg.get("port_forwards", "")
        return {
            "name": name,
            "running": running,
            "pid": as_int(live.get("pid")),
            "os": str(live.get("os", "")),
            "hostname": str(live.get("hostname") or cfg.get("hostname") or name),
            "ip": str(live.get("ip", "")),
            "ip6": str(live.get("ip6", "")),
            "uptime_sec": as_int(live.get("uptime_sec")),
            "uptime": str(live.get("uptime", "")),
            "ram_used_kb": as_int(live.get("ram_used_kb")),
            "ram_limit_kb": as_int(live.get("ram_limit_kb")) or (mem_limit // 1024 if mem_limit else 0),
            "cpu_permill": as_int(live.get("cpu_permill")),
            "cpu_limit_permill": as_int(live.get("cpu_limit_permill")),
            "swap_allowed": bool(live.get("swap_allowed", False)),
            "x11": bool(live.get("x11", 0)),
            "rootfs_path": rootfs,
            "rootfs_kind": kind,
            "rootfs_exists": kind not in ("missing", "unknown"),
            "net_mode": cfg.get("net_mode", "nat"),
            "port_forwards": ports,
            "static_nat_ip": cfg.get("static_nat_ip", ""),
            "memory_limit_bytes": mem_limit,
            "cpu_quota": quota,
            "cpu_period": period,
            "cpu_limit_cores": round(quota / period, 2) if quota > 0 else 0,
            "pids_limit": as_int(cfg.get("pids_limit")),
            "privileged": cfg.get("privileged", ""),
            "bind_mounts": cfg.get("bind_mounts", ""),
            "dns_servers": cfg.get("dns_servers", ""),
            "allow_swap": cfg.get("allow_swap", ""),
            "log_path": log_path,
            "log_size": log_size,
        }

    # -- actions --------------------------------------------------------
    def create(self, item):
        name = str(item.get("name", ""))
        req = str(item.get("req", ""))

        def progress(message):
            self.emit({"type": "progress", "req": req, "action": "create",
                       "stage": message})

        def fail(message, code=1):
            return self.result(req, "create", False, code, message, name)

        if not NAME_RE.match(name):
            return fail("Invalid container name.", 2)

        raw_tarball = str(item.get("tarball", "")).strip()
        if not raw_tarball:
            return fail("Choose a rootfs tarball.")
        if not (raw_tarball.startswith("/") or raw_tarball.startswith("~")):
            return fail("Tarball path must be absolute.")
        tarball = user_path(raw_tarball)
        if not os.path.isfile(tarball):
            return fail("Tarball not found: " + tarball)
        if not os.access(tarball, os.R_OK):
            return fail("Tarball is not readable: " + tarball)

        size = parse_size(item.get("size") or "16G")
        if size is None:
            return fail("Invalid image size. Use a value like 16G.")
        if size < MIN_IMAGE_SIZE:
            return fail("Image size must be at least %dM." % (MIN_IMAGE_SIZE >> 20))

        container_dir = os.path.join(self.workspace, "Containers", name)
        config_path = os.path.join(container_dir, "container.config")
        if os.path.exists(config_path):
            return fail("A container named %s already exists." % name)

        raw_image = str(item.get("image", "")).strip()
        if raw_image and not (raw_image.startswith("/") or raw_image.startswith("~")):
            return fail("Image path must be absolute.")
        image = user_path(raw_image) or os.path.join(container_dir, "rootfs.img")
        if os.path.exists(image):
            return fail("Image already exists: " + image)

        hostname = str(item.get("hostname") or name).strip() or name
        if not re.match(r"^[A-Za-z0-9][A-Za-z0-9.-]{0,254}$", hostname):
            hostname = name
        config_text, config_error = build_container_config(item, name, hostname, image)
        if config_error:
            return fail(config_error)

        mountpoint = os.path.join(container_dir, ".create-mnt")
        mount_tool = find_tool("mount", "/bin/mount", "/usr/bin/mount")
        umount_tool = find_tool("umount", "/bin/umount", "/usr/bin/umount")
        tar_tool = find_tool("tar", "/bin/tar", "/usr/bin/tar")
        mkfs_tool = find_tool("mkfs.ext4", "/sbin/mkfs.ext4", "/usr/sbin/mkfs.ext4")
        mke2fs_tool = find_tool("mke2fs", "/sbin/mke2fs", "/usr/sbin/mke2fs")
        if not mount_tool or not umount_tool:
            return fail("mount/umount were not found.")
        if not tar_tool:
            return fail("tar was not found.")
        if not mkfs_tool and not mke2fs_tool:
            return fail("mkfs.ext4 was not found.")

        created_image = False
        mounted = False
        config_written = False
        try:
            progress("Preparing %s…" % name)
            try:
                os.makedirs(container_dir, mode=0o755, exist_ok=True)
                parent = os.path.dirname(image)
                if parent:
                    os.makedirs(parent, mode=0o755, exist_ok=True)
                fd = os.open(image, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
                try:
                    os.ftruncate(fd, size)
                finally:
                    os.close(fd)
                created_image = True
            except OSError as exc:
                return fail("Cannot create image: %s" % exc)

            progress("Formatting %s…" % os.path.basename(image))
            label = name[:16]
            if mkfs_tool:
                mkfs_args = [mkfs_tool, "-F", "-L", label, image]
            else:
                mkfs_args = [mke2fs_tool, "-t", "ext4", "-F", "-L", label, image]
            code, out, err = run_process(mkfs_args, 300)
            if code != 0:
                return fail("mkfs.ext4 failed: " + command_error(code, out, err))

            progress("Mounting image…")
            try:
                os.makedirs(mountpoint, mode=0o755, exist_ok=True)
            except OSError as exc:
                return fail("Cannot create mount point: %s" % exc)
            code, out, err = run_process(
                [mount_tool, "-t", "ext4", "-o", "loop,rw", image, mountpoint], 120)
            if code != 0:
                return fail("Mount failed: " + command_error(code, out, err))
            mounted = True

            progress("Extracting %s…" % os.path.basename(tarball))
            code, out, err = run_process(
                [tar_tool, "-xf", tarball, "-C", mountpoint], CREATE_TIMEOUT)
            if code != 0:
                return fail("Extraction failed: " + command_error(code, out, err))
            os.sync()

            if not (os.path.lexists(os.path.join(mountpoint, "sbin/init")) or
                    os.path.lexists(os.path.join(mountpoint, "usr/sbin/init"))):
                return fail("The tarball does not look like a Linux rootfs: /sbin/init is missing.")

            progress("Unmounting image…")
            code, out, err = run_process([umount_tool, mountpoint], 120)
            if code != 0:
                run_process([umount_tool, "-l", mountpoint], 60)
            mounted = os.path.ismount(mountpoint)
            if mounted:
                return fail("Could not unmount the image: " + command_error(code, out, err))
            try:
                os.rmdir(mountpoint)
            except OSError:
                pass

            progress("Writing container configuration…")
            write_config(config_path, config_text)
            config_written = True

            started = False
            start_error = ""
            if item.get("start"):
                progress("Starting %s…" % name)
                code, out, err = self.run([DROIDSPACES, "--name=" + name, "start"], 300)
                if code == 0:
                    started = True
                else:
                    start_error = command_error(code, out, err)

            message = "Created %s." % name
            if item.get("start"):
                message += " Started." if started else " Start failed: " + start_error
            result = self.result(req, "create", True, 0, message, name)
            result["started"] = started
            result["start_error"] = start_error
            return result
        except Exception as exc:
            return fail("Creation failed: %s" % exc)
        finally:
            if mounted:
                run_process([umount_tool, "-l", mountpoint], 60)
            try:
                os.rmdir(mountpoint)
            except OSError:
                pass
            if created_image and not config_written and not os.path.ismount(mountpoint):
                try:
                    os.unlink(image)
                except OSError:
                    pass

    def run_action(self, item):
        action = item.get("action")
        name = item.get("name", "")
        req = item.get("req", "")
        lines = max(1, min(2000, as_int(item.get("lines"), 120)))

        if action == "create":
            return self.create(item)

        if action in ACTIONS:
            if not NAME_RE.match(name):
                return self.result(req, action, False, 2, "Invalid container name.")
            if action == "start":
                cfg = read_config(os.path.join(
                    self.workspace, "Containers", name, "container.config")) or {}
                rootfs = cfg.get("rootfs_path", "")
                if rootfs and rootfs_kind(rootfs) in ("missing", "unknown"):
                    return self.result(
                        req, action, False, 1,
                        "Rootfs is missing: " + rootfs, name,
                    )
            code, out, err = self.run(
                [DROIDSPACES, "--name=" + name, action],
                300 if action in ("start", "restart") else 120,
            )
            text = clean(out or err, 500)
            message = text.splitlines()[-1] if text else (
                "%s finished" % action if code == 0 else "droidspaces exited with code %d" % code
            )
            return self.result(req, action, code == 0, code, message, name)

        if action == "logs":
            if not NAME_RE.match(name):
                return self.result(req, action, False, 2, "Invalid container name.")
            path, _ = log_info(self.workspace, name)
            try:
                with open(path, "r", encoding="utf-8", errors="replace") as handle:
                    tail = handle.readlines()[-lines:]
                text = clean("".join(tail))
            except OSError as exc:
                return self.result(req, action, False, 1, str(exc), name)
            return self.result(req, action, True, 0, text, name)

        if action == "check":
            code, out, err = self.run([DROIDSPACES, "--json", "check"], 90)
            text = clean(out or err)
            summary = summarize_check(text)
            if summary is not None:
                message, passed = summary
                return self.result(req, action, code == 0 and passed, code, message)
            return self.result(req, action, code == 0, code, text or "check finished")

        return self.result(req, action, False, 2, "Unknown command.", name)

    def result(self, req, action, ok, code, message, name=""):
        return {
            "type": "result",
            "req": req,
            "action": action,
            "name": name,
            "ok": bool(ok),
            "code": code,
            "message": message,
        }

    def worker(self):
        while not self.stop.is_set():
            try:
                item = self.actions.get(timeout=0.25)
            except queue.Empty:
                continue
            if item is None:
                return
            try:
                self.emit(self.run_action(item))
            except Exception as exc:  # pragma: no cover - defensive
                self.emit(self.result(item.get("req", ""), item.get("action", ""),
                                      False, 1, "Helper error: %s" % exc,
                                      item.get("name", "")))
            self.dirty.set()

    # -- protocol -------------------------------------------------------
    def handle(self, msg):
        if not isinstance(msg, dict):
            return
        cmd = msg.get("cmd")
        if cmd not in COMMANDS:
            self.emit({"type": "result", "req": str(msg.get("req", "")),
                       "action": str(cmd), "ok": False, "code": 2,
                       "message": "Unsupported command."})
            return
        if cmd == "exit":
            self.stop.set()
        elif cmd == "refresh":
            self.dirty.set()
        elif cmd == "watch":
            self.open = bool(msg.get("open"))
            self.interval = OPEN_INTERVAL if self.open else IDLE_INTERVAL
        elif cmd in ACTIONS or cmd in ("logs", "check", "create"):
            item = {
                "action": cmd,
                "name": str(msg.get("name", "")),
                "req": str(msg.get("req", "")),
                "lines": msg.get("lines", 120),
            }
            if cmd == "create":
                options = msg.get("options")
                item.update({
                    "tarball": str(msg.get("tarball", "")),
                    "image": str(msg.get("image", "")),
                    "size": str(msg.get("size", "16G")),
                    "hostname": str(msg.get("hostname", "")),
                    "start": bool(msg.get("start", False)),
                    "options": options if isinstance(options, dict) else {},
                })
            self.actions.put(item)

    def read_stdin(self):
        while not self.stop.is_set():
            line = sys.stdin.readline()
            if not line:
                self.commands.put(None)
                return
            if len(line) > MAX_LINE:
                continue
            line = line.strip()
            if not line:
                continue
            try:
                msg = json.loads(line)
            except ValueError:
                continue
            self.commands.put(msg)

    def loop(self):
        reader = threading.Thread(target=self.read_stdin, name="stdin", daemon=True)
        reader.start()
        worker = threading.Thread(target=self.worker, name="actions", daemon=True)
        worker.start()

        self.emit({
            "type": "hello",
            "euid": os.geteuid(),
            "workspace": self.workspace,
            "version": self.version,
            "pid": os.getpid(),
        })

        next_state = 0.0
        parent = os.getppid()
        while not self.stop.is_set():
            # If the shell that started us is gone, do not linger as a root
            # process. (Quickshell may not reap our end of the pipe.)
            if os.getppid() != parent:
                break
            try:
                msg = self.commands.get(timeout=0.4)
            except queue.Empty:
                msg = False
            if msg is None:
                break
            if msg is not False:
                self.handle(msg)
            now = time.monotonic()
            if self.dirty.is_set() or now >= next_state:
                self.dirty.clear()
                try:
                    self.emit(self.collect())
                except Exception as exc:  # pragma: no cover - defensive
                    self.emit({"type": "fatal", "message": "State error: %s" % exc})
                next_state = time.monotonic() + self.interval

        self.stop.set()
        self.actions.put(None)
        self.emit({"type": "bye"})
        return 0


def main():
    parser = argparse.ArgumentParser(description="Droidspaces Omarchy bridge")
    parser.add_argument("--workspace", default=os.environ.get("DS_WORKSPACE", DEFAULT_WORKSPACE))
    parser.add_argument("--allow-nonroot", action="store_true",
                        help="collect config-only state without root (testing)")
    parser.add_argument("--once", action="store_true", help="print one state and exit")
    parser.add_argument("--replace", action="store_true",
                        help="stop older copies of this bridge before starting")
    parser.add_argument("--interval", type=float, default=0.0, help=argparse.SUPPRESS)
    args = parser.parse_args()

    if os.geteuid() != 0 and not args.allow_nonroot:
        sys.stderr.write("droidspaces-bridge: root privileges required\n")
        return 77

    if args.replace and os.geteuid() == 0:
        replace_instances(sys.argv[0])

    workspace = os.path.abspath(args.workspace)
    bridge = Bridge(workspace, allow_nonroot=args.allow_nonroot, once=args.once)
    if args.interval > 0:
        bridge.interval = args.interval
    bridge.probe()

    if args.once:
        bridge.emit(bridge.collect())
        return 0
    try:
        return bridge.loop()
    except KeyboardInterrupt:
        return 0
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main())
